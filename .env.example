# Copy to .env and fill in. Never commit .env.

# LLM (you only need the one matching llm.provider in config.yaml)
GEMINI_API_KEY=
GROQ_API_KEY=
LOCAL_LLM_KEY=not-needed

# Used later by the visuals stage
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Used later by the approval bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wikimedia asks every client to identify itself with a contact.
WIKI_USER_AGENT=DocuPipeline/0.1 (contact: you@example.com)
